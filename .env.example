# Supabase → Project Settings → API (예: 프로젝트 ref yquukpfzcpgvglimnblp)
VITE_SUPABASE_URL=https://yquukpfzcpgvglimnblp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase → Authentication → URL Configuration
# Site URL: 로컬 예) http://localhost:5173  배포 예) https://your-domain.com
# Redirect URLs에 이메일 인증·비밀번호 재설정 후 돌아올 주소 추가:
#   http://localhost:5173/auth/callback
#   https://your-domain.com/auth/callback

# 링크 카드 미리보기(Microlink) — 없어도 동작, 있으면 할당량 여유
# VITE_MICROLINK_API_KEY=
